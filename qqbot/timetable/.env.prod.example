# 复制本文件为 .env.prod 并填入真实配置：cp .env.prod.example .env.prod
# .env.prod 含密钥，已加入 .gitignore，请勿提交

# NoneBot 驱动：QQ 适配器要求 fastapi + httpx + websockets（WebSocket 连接方式）
DRIVER=~fastapi+~httpx+~websockets

# NoneBot HTTP 服务监听地址与端口
HOST=127.0.0.1
PORT=8084

# 命令前缀：标准 / 命令（如 /timetable），仅 / 开头触发
COMMAND_START=["/"]

# QQ 官方机器人（QQ 开放平台 https://bot.q.qq.com）
# 沙箱环境开关：测试机器人填 true，正式发布填 false
QQ_IS_SANDBOX=false

# 机器人列表（JSON 数组格式，注意必须是合法 JSON，外层用单引号包裹）
# id:     AppID（开放平台应用管理页获取）
# token:  适配器当前未使用但为必填字段，填任意非空值即可
# secret: Client Secret（开放平台应用管理页获取）
# intent: 需要订阅的事件；c2c_group_at_messages 为单聊/群@消息，公域群/私聊机器人必备
# use_websocket: true 使用 WebSocket 连接（推荐，无需公网回调地址）；
#                false 使用 Webhook，需要公网 HTTPS 地址（回调路径 /qq/webhook）
QQ_BOTS='[{"id":"你的AppID","token":"any-token","secret":"你的ClientSecret","intent":{"guilds":true,"guild_members":true,"guild_message_reactions":true,"c2c_group_at_messages":true,"group_members":true,"at_messages":true,"message_audit":true},"use_websocket":true}]'

# localstore 使用项目根目录下的 data/ 目录（htmlrender 浏览器缓存等）
LOCALSTORE_USE_CWD=true

# HTML 渲染（nonebot-plugin-htmlrender，用于课表图片渲染）
# provider: playwright；startup: warmup 启动时预热浏览器（首次渲染更快）
RENDER__PROVIDER=playwright
RENDER__STARTUP=warmup

# 课表插件可选配置（不填使用默认值）
TIMETABLE_BASE_URL=https://jw.cidp.edu.cn   # 教务系统地址
TIMETABLE_TIMEOUT=30.0                      # 查询接口超时时间（秒）
